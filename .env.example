# Life's Leftovers — environment variables.
# Copy to .env.local for local development. Real values live in .env.local and Vercel; never commit them.
# Defaults below match the local stack (`pnpm db:start`). Test/sandbox keys only outside production.
# Validated in src/lib/env.ts — keep both files in sync.

# --- App -------------------------------------------------------------------
# Public base URL (used in emails, share links, Stripe return URLs).
APP_URL=http://localhost:3000

# --- Database: Supabase Postgres + PostGIS -----------------------------------
# Local: from `pnpm exec supabase status`. Production: Supabase pooler URL (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase API (Auth + Realtime). Local URL is fixed; keys come from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Images: Cloudflare R2 (MinIO locally) -----------------------------------
# Local MinIO from docker-compose.yml. Production: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=lifesleftovers
S3_SECRET_ACCESS_KEY=lifesleftovers-dev-secret
S3_BUCKET=listings
# MinIO needs path-style URLs; R2 doesn't.
S3_FORCE_PATH_STYLE=1
# Where browsers load images from. Production: the R2 custom domain (proxied through Cloudflare).
NEXT_PUBLIC_IMAGE_BASE_URL=http://127.0.0.1:9000/listings
# "cloudflare" builds /cdn-cgi/image/... resize URLs; "none" serves originals (local).
IMAGE_TRANSFORMS=none

# --- Email: Mailpit locally (http://localhost:8025), Resend in production ----
EMAIL_FROM="Life's Leftovers <hello@lifesleftovers.com>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Production only. When set, email goes through Resend instead of SMTP.
RESEND_API_KEY=

# --- Stripe Connect (test mode everywhere but production) --------------------
# sk_test_... from the Stripe dashboard (Developers → API keys). Live keys are refused outside production.
STRIPE_SECRET_KEY=
# whsec_... printed by `pnpm stripe:listen` locally; from the webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio Verify (phone checks) --------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Cloudflare Turnstile (bot checks) ----------------------------------------
# Cloudflare's published test keys: these always pass. Use 2x00000000000000000000AB to always fail.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Inngest (scheduled and background jobs) ----------------------------------
# Local: leave keys empty and keep INNGEST_DEV=1 (talks to `pnpm jobs:dev` at :8288).
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Observability: off unless set, and only active in production builds ------
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps from CI/Vercel.
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Web push (VAPID). Generate once: `pnpm dlx web-push generate-vapid-keys` --
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- AI listing help and moderation (Milestone 3) ------------------------------
ANTHROPIC_API_KEY=

# --- Rate limiting: Upstash in production; in-memory fallback locally ---------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Privacy -------------------------------------------------------------------
# Encrypts exact pickup addresses (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different key in every environment. Losing it makes stored addresses unreadable.
ADDRESS_ENCRYPTION_KEY=

# --- Dev-only switches (refused when NODE_ENV=production) ---------------------
# 1 = Closing Night starts 10 minutes from now and auctions last 5 minutes.
FAST_CLOCK=0
# 1 = phone verification accepts the fixed code 000000 instead of calling Twilio.
ALLOW_DEV_OTP=0
