# Read by the Supabase CLI (supabase/config.toml env(...) values). `pnpm db:start` copies this to
# supabase/.env (gitignored) if it's missing. Restart Supabase after changes:
#   pnpm db:stop && pnpm db:start

# Google sign-in (README → "Turn on Google sign-in"). Local OAuth client values from Google Cloud.
# Leave ENABLED=false until both values are filled in.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
